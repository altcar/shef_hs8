{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wizzibiz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wizzibiz",
      "database_id": "044c2315-28b2-44c3-b030-517b1baa2a6d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
